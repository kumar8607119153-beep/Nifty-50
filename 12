<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Nifty 50 — Option Intelligence Engine with Zero-to-Hero Scanner</title>
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
</head>
<body class="bg-slate-950 text-slate-100 font-sans antialiased min-h-screen p-1 sm:p-4">
    <div class="max-w-full mx-auto space-y-3">
        
        <!-- Top Dark Navigation Bar -->
        <header class="bg-[#1b1b2f] border-b border-slate-800 rounded-t-xl px-4 py-3 flex items-center justify-between shadow-md">
            <div class="flex items-center gap-2">
                <span class="text-xs font-bold tracking-wider text-indigo-400 uppercase">Option Intelligence Engine</span>
            </div>
            <div class="text-right">
                <p class="text-xs font-semibold text-white">Sanjay Rana</p>
                <p class="text-[10px] text-slate-400 font-mono">Mob: 8930814389</p>
            </div>
        </header>

        <!-- Sub Menu Bar -->
        <nav class="bg-[#1b1b2f]/80 backdrop-blur px-3 py-2 flex items-center justify-between text-[11px] text-slate-300 border-x border-slate-800">
            <div class="flex items-center gap-2">
                <select id="index-select" onchange="refreshIndex()" class="bg-indigo-950 text-indigo-300 px-2 py-1 rounded border border-indigo-800 text-[10px] font-bold">
        <option value="NIFTY">NIFTY 50</option>
        <option value="BANKNIFTY">BANK NIFTY</option>
        <option value="SENSEX">SENSEX</option>
    </select>
                <span class="bg-indigo-950 text-indigo-300 px-2 py-0.5 rounded border border-indigo-800 text-[10px]">Supertrend & Zero-to-Hero Scanner</span>
            </div>
            <div class="text-[10px] text-amber-400 font-mono font-bold">
                Ready for Live Setup
            </div>
        </nav>

        <!-- Main Exchange Header Box -->
        <div class="bg-white text-slate-900 rounded-b-xl p-3 sm:p-4 shadow-xl border border-slate-200 space-y-4">
            
            <!-- NSE Brand & Title Row -->
            <div class="flex justify-between items-center border-b border-slate-100 pb-3">
                <div class="flex items-center gap-2">
                    <div class="flex gap-0.5 items-center">
                        <div class="w-3 h-4 bg-amber-500 rounded-sm"></div>
                        <div class="w-3 h-6 bg-indigo-600 rounded-sm"></div>
                        <div class="w-3 h-5 bg-emerald-500 rounded-sm"></div>
                    </div>
                    <span id="index-title" class="text-lg sm:text-xl font-black tracking-tight text-slate-900">NSE NIFTY 50</span>
                </div>
                
                <!-- Expiry Date Selector Dropdown -->
                <div class="flex items-center gap-2">
                    <div class="text-right">
                        <label for="expiry-select" class="block text-[9px] font-bold text-slate-500 uppercase">Select Expiry</label>
                        <select id="expiry-select" onchange="refreshData()" class="bg-slate-100 border border-slate-300 text-slate-900 text-xs font-semibold rounded-lg px-2 py-1 focus:outline-none focus:ring-1 focus:ring-indigo-500">
                            <option value="17-Sep-2026">17 Sep 2026 (Weekly)</option>
                            <option value="24-Sep-2026">24 Sep 2026 (Weekly)</option>
                            <option value="29-Sep-2026">29 Sep 2026 (Monthly)</option>
                            <option value="08-Oct-2026">08 Oct 2026 (Weekly)</option>
                        </select>
                    </div>
                    <button onclick="refreshData()" class="px-2.5 py-1.5 bg-slate-900 text-white rounded-lg text-xs font-semibold hover:bg-slate-800 transition shadow mt-3">
                        🔄
                    </button>
                </div>
            </div>

            <!-- Live Spot & Index Supertrend Box -->
            <div class="space-y-2">
                <div class="border border-slate-200 rounded-xl p-3 bg-slate-50">
                    <span id="spot-label" class="text-[10px] text-slate-400 font-bold uppercase">Nifty Spot Price</span>
                    <div id="spot-price" class="text-lg sm:text-xl font-extrabold font-mono text-slate-900 mt-0.5">23,435.30</div>
                    <div class="text-xs font-semibold text-rose-600 mt-0.5">▼ -79.70 (-0.34%)</div>
                </div>

                <div class="border border-slate-200 rounded-xl p-3 bg-slate-50 space-y-2">
                    <div class="flex justify-between items-center">
                        <span class="text-[10px] text-slate-500 font-bold uppercase">Index Supertrend (1m & 5m Overview)</span>
                        <span class="text-[9px] font-mono font-bold text-indigo-600">Active Setup</span>
                    </div>
                    <div class="grid grid-cols-2 gap-2">
                        <div class="bg-white p-2 rounded-lg border border-slate-200 shadow-sm">
                            <div class="flex justify-between text-[9px] font-bold text-slate-400 mb-1">
                                <span>1M ENTRY</span>
                                <span>1M TSL</span>
                            </div>
                            <div class="flex justify-between items-center font-mono">
                                <span class="text-xs font-bold text-slate-800">23,337.9</span>
                                <div class="text-right">
                                    <span class="text-xs font-bold text-emerald-600">23,368.2</span>
                                    <span class="text-[10px] text-emerald-600 font-bold">▲</span>
                                </div>
                            </div>
                        </div>
                        <div class="bg-white p-2 rounded-lg border border-slate-200 shadow-sm">
                            <div class="flex justify-between text-[9px] font-bold text-slate-400 mb-1">
                                <span>5M ENTRY</span>
                                <span>5M TSL</span>
                            </div>
                            <div class="flex justify-between items-center font-mono">
                                <span class="text-xs font-bold text-slate-800">23,300.0</span>
                                <div class="text-right">
                                    <span class="text-xs font-bold text-emerald-600">23,256.7</span>
                                    <span class="text-[10px] text-emerald-600 font-bold">▲</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Option Chain Intelligence Table -->
            <div class="space-y-2 pt-1">
                <div class="flex justify-between items-center">
                    <h3 class="text-[10px] sm:text-xs font-bold text-slate-700 uppercase tracking-wider">Option Chain Intelligence Table (ATP Crossing & Independent 1m/5m Supertrend)</h3>
                    <span id="atm-badge" class="text-[10px] font-mono bg-slate-100 text-slate-700 px-2 py-0.5 rounded border border-slate-200">ATM: 23,450 | Exp: 17-Sep-2026</span>
                </div>

                <div class="overflow-x-auto border border-slate-200 rounded-xl max-h-[550px]">
                    <table class="w-full text-center border-collapse text-[10px] sm:text-[11px]">
                        <thead>
                            <tr class="bg-slate-100 text-slate-700 border-b border-slate-200 font-bold text-[9px]">
                                <th class="p-1.5 border-r border-slate-200 bg-emerald-50 text-emerald-900" colspan="4">CALL (CE) Data</th>
                                <th class="p-1.5 bg-slate-200 text-slate-900 w-20">STRIKE</th>
                                <th class="p-1.5 border-l border-slate-200 bg-rose-50 text-rose-900" colspan="4">PUT (PE) Data</th>
                            </tr>
                            <tr class="bg-slate-50 text-slate-500 border-b border-slate-200 text-[8px]">
                                <th class="p-1">LTP (+/-)</th>
                                <th class="p-1 bg-emerald-100/45">ATP</th>
                                <th class="p-1">1m Entry / TSL</th>
                                <th class="p-1 border-r border-slate-200">5m Entry / TSL</th>
                                <th class="p-1 bg-slate-100 font-bold text-slate-800">PRICE</th>
                                <th class="p-1 border-l border-slate-200">LTP (+/-)</th>
                                <th class="p-1 bg-rose-100/45">ATP</th>
                                <th class="p-1">1m Entry / TSL</th>
                                <th class="p-1">5m Entry / TSL</th>
                            </tr>
                        </thead>
                        <tbody id="chain-tbody" class="divide-y divide-slate-100 font-mono text-[9px] sm:text-[10px]">
                            <!-- Dynamic rows injected here -->
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- ZERO TO HERO SCANNER SECTION (Placed at the Very Bottom) -->
            <div class="border-t border-slate-200 pt-3 space-y-2">
                <div class="flex justify-between items-center bg-amber-50 border border-amber-200 rounded-lg p-2.5">
                    <div>
                        <h4 class="text-xs font-bold text-amber-900 uppercase">⚡ Zero-to-Hero Expiry Scanner</h4>
                        <p class="text-[9px] text-amber-700">Filtering OTM strikes with low premium (₹2 - ₹15) for high-momentum expiry moves.</p>
                    </div>
                    <span id="scanner-expiry-lbl" class="text-[9px] font-mono bg-amber-200 text-amber-900 px-2 py-0.5 rounded font-bold">Exp: 17-Sep-2026</span>
                </div>

                <div class="grid grid-cols-1 sm:grid-cols-2 gap-2">
                    <!-- Call Side Zero-to-Hero Box -->
                    <div class="bg-emerald-50/60 border border-emerald-200 rounded-xl p-2.5 space-y-1.5">
                        <div class="flex justify-between items-center text-[10px] font-bold text-emerald-900 border-b border-emerald-200 pb-1">
                            <span>🚀 Call Side Zero-to-Hero (CE)</span>
                            <span class="text-[9px] bg-emerald-200 text-emerald-900 px-1.5 py-0.5 rounded">Target: OTM Strikes</span>
                        </div>
                        <div id="zth-call-list" class="space-y-1 font-mono text-[10px]">
                            <!-- Injected via JS -->
                        </div>
                    </div>

                    <!-- Put Side Zero-to-Hero Box -->
                    <div class="bg-rose-50/60 border border-rose-200 rounded-xl p-2.5 space-y-1.5">
                        <div class="flex justify-between items-center text-[10px] font-bold text-rose-900 border-b border-rose-200 pb-1">
                            <span>📉 Put Side Zero-to-Hero (PE)</span>
                            <span class="text-[9px] bg-rose-200 text-rose-900 px-1.5 py-0.5 rounded">Target: OTM Strikes</span>
                        </div>
                        <div id="zth-put-list" class="space-y-1 font-mono text-[10px]">
                            <!-- Injected via JS -->
                        </div>
                    </div>
                </div>
            </div>

        </div>

        <!-- Footer -->
        <p class="text-center text-[10px] text-slate-500 font-mono">
            Nifty 50 Engine • Manual Execution Only
        </p>

    </div>

    <script>
        // Index selection layer: the existing option-chain / ATP / Supertrend /
        // Zero-to-Hero formulas below are intentionally unchanged.
        const INDEX_CONFIG = {
            NIFTY: {
                title: 'NSE NIFTY 50',
                spotLabel: 'Nifty Spot Price',
                footer: 'Nifty 50 Engine • Manual Execution Only',
                spot: 23435.30,
                step: 50,
                expiries: [
                    ['17-Sep-2026', '17 Sep 2026 (Weekly)'],
                    ['24-Sep-2026', '24 Sep 2026 (Weekly)'],
                    ['29-Sep-2026', '29 Sep 2026 (Monthly)'],
                    ['08-Oct-2026', '08 Oct 2026 (Weekly)']
                ]
            },
            BANKNIFTY: {
                title: 'NSE BANK NIFTY',
                spotLabel: 'Bank Nifty Spot Price',
                footer: 'Bank Nifty Engine • Manual Execution Only',
                spot: 54000.00,
                step: 100,
                expiries: [
                    ['17-Sep-2026', '17 Sep 2026 (Weekly)'],
                    ['24-Sep-2026', '24 Sep 2026 (Weekly)'],
                    ['29-Sep-2026', '29 Sep 2026 (Monthly)'],
                    ['08-Oct-2026', '08 Oct 2026 (Weekly)']
                ]
            },
            SENSEX: {
                title: 'BSE SENSEX',
                spotLabel: 'Sensex Spot Price',
                footer: 'Sensex Engine • Manual Execution Only',
                spot: 83000.00,
                step: 100,
                expiries: [
                    ['17-Sep-2026', '17 Sep 2026 (Weekly)'],
                    ['24-Sep-2026', '24 Sep 2026 (Weekly)'],
                    ['29-Sep-2026', '29 Sep 2026 (Monthly)'],
                    ['08-Oct-2026', '08 Oct 2026 (Weekly)']
                ]
            }
        };

        function refreshIndex() {
            const selectedIndex = document.getElementById('index-select').value;
            const config = INDEX_CONFIG[selectedIndex];

            document.getElementById('index-title').innerText = config.title;
            document.getElementById('spot-label').innerText = config.spotLabel;

            const expirySelect = document.getElementById('expiry-select');
            const current = expirySelect.value;
            expirySelect.innerHTML = config.expiries.map(e =>
                `<option value="${e[0]}">${e[1]}</option>`
            ).join('');
            if (config.expiries.some(e => e[0] === current)) {
                expirySelect.value = current;
            }

            const footer = document.querySelector('body > div > p');
            if (footer) footer.innerText = config.footer;

            refreshData();
        }

        function refreshData() {
            let selectedIndex = document.getElementById('index-select')?.value || 'NIFTY';
            let config = INDEX_CONFIG[selectedIndex] || INDEX_CONFIG.NIFTY;
            let spot = config.spot;
            let step = config.step;
            let atm = Math.round(spot / step) * step;
            let selectedExpiry = document.getElementById('expiry-select').value;

            document.getElementById('spot-price').innerText = `₹${spot.toLocaleString('en-IN')}`;
            let shortExp = `${selectedExpiry.split('-').slice(0,2).join('-')}-${selectedExpiry.split('-')[2]}`;
            document.getElementById('atm-badge').innerText = `ATM: ${atm.toLocaleString('en-IN')} | Exp: ${shortExp}`;
            document.getElementById('scanner-expiry-lbl').innerText = `Exp: ${shortExp}`;

            let tbody = document.getElementById('chain-tbody');
            tbody.innerHTML = '';

            let zthCallHtml = '';
            let zthPutHtml = '';

            for(let i = -7; i <= 7; i++) {
                let strike = atm + (i * step);
                let isAtm = (i === 0);

                let callLtp = Number(Math.max(2, 220 - (i * 30)).toFixed(2));
                let putLtp = Number(Math.max(2, 10 + (i * 30)).toFixed(2));
                
                let callChange = Number((-12.9 + (i * 1.5)).toFixed(2));
                let putChange = Number((10.9 + (i * 1.5)).toFixed(2));

                let callAtp = Number((callLtp + (i % 2 === 0 ? 4.5 : -5.5)).toFixed(2));
                let putAtp = Number((putLtp + (i % 3 === 0 ? -4.0 : 6.0)).toFixed(2));

                // Zero-to-Hero Scanner logic: Checking OTM strikes with low premium (₹2 to ₹15)
                if (i > 2 && callLtp >= 2 && callLtp <= 15) {
                    zthCallHtml += `
                        <div class="flex justify-between items-center bg-white p-1.5 rounded border border-emerald-100 shadow-xs">
                            <span class="font-bold text-slate-800">Strike: ${strike} CE</span>
                            <span class="text-emerald-700 font-bold">LTP: ₹${callLtp}</span>
                            <span class="text-[8px] text-slate-500">Logic: OTM Momentum</span>
                        </div>
                    `;
                }

                if (i < -2 && putLtp >= 2 && putLtp <= 15) {
                    zthPutHtml += `
                        <div class="flex justify-between items-center bg-white p-1.5 rounded border border-rose-100 shadow-xs">
                            <span class="font-bold text-slate-800">Strike: ${strike} PE</span>
                            <span class="text-rose-700 font-bold">LTP: ₹${putLtp}</span>
                            <span class="text-[8px] text-slate-500">Logic: OTM Breakdown</span>
                        </div>
                    `;
                }

                let getLtpCell = (ltp, change) => {
                    let isPlus = change >= 0;
                    let colorClass = isPlus ? 'text-emerald-600' : 'text-rose-600';
                    let sign = isPlus ? '+' : '';
                    return `
                        <div class="font-semibold text-slate-900">₹${ltp}</div>
                        <div class="text-[8px] font-bold ${colorClass}">${sign}${change}</div>
                    `;
                };

                let getAtpCrossCell = (atp, ltp) => {
                    let isCrossedUp = ltp >= atp;
                    let actionText = isCrossedUp ? 'BUY' : 'SELL';
                    let arrow = isCrossedUp ? '▲' : '▼';
                    let badgeBg = isCrossedUp ? 'text-emerald-700 bg-emerald-50' : 'text-rose-700 bg-rose-50';
                    return `
                        <div class="font-bold text-slate-800">₹${atp}</div>
                        <div class="inline-block px-1.5 py-0.5 rounded font-bold text-[8px] ${badgeBg}">
                            ${actionText} ${arrow}
                        </div>
                    `;
                };

                let getSupertrendEntryCell = (ltp, isCall, is1Min) => {
                    let seedFactor = isCall ? (i + (is1Min ? 1 : 2)) : (i - (is1Min ? 1 : 2));
                    let isSupertrendBuy = (seedFactor % 2 === 0);
                    let arrow = isSupertrendBuy ? '▲' : '▼';
                    let colorClass = isSupertrendBuy ? 'text-emerald-600' : 'text-rose-600';
                    
                    let offset = is1Min ? 5.0 : 8.0;
                    let entryVal = Number(Math.max(2, ltp - (isSupertrendBuy ? offset : -offset)).toFixed(1));
                    let tslVal = Number(Math.max(1, entryVal - (isSupertrendBuy ? 4.0 : -4.0)).toFixed(1));

                    return `
                        <div class="text-[8px] text-slate-600 leading-tight">
                            Ent: <span class="font-bold text-slate-800">${entryVal}</span><br>
                            TSL: <span class="font-bold ${colorClass}">${tslVal} ${arrow}</span>
                        </div>
                    `;
                };

                let rowClass = isAtm ? 'bg-amber-100/90 font-bold' : (i % 2 === 0 ? 'bg-white' : 'bg-slate-50/60');

                tbody.innerHTML += `
                    <tr class="${rowClass} hover:bg-indigo-50/50 transition">
                        <!-- CALL SIDE -->
                        <td class="p-2">${getLtpCell(callLtp, callChange)}</td>
                        <td class="p-2 bg-emerald-50/30">${getAtpCrossCell(callAtp, callLtp)}</td>
                        <td class="p-2">${getSupertrendEntryCell(callLtp, true, true)}</td>
                        <td class="p-2 border-r border-slate-200 bg-emerald-50/40">${getSupertrendEntryCell(callLtp, true, false)}</td>

                        <!-- STRIKE -->
                        <td class="p-2 font-bold text-slate-900 bg-slate-100/80">
                            <div>${strike.toLocaleString('en-IN')}</div>
                        </td>

                        <!-- PUT SIDE -->
                        <td class="p-2 border-l border-slate-200">${getLtpCell(putLtp, putChange)}</td>
                        <td class="p-2 bg-rose-50/30">${getAtpCrossCell(putAtp, putLtp)}</td>
                        <td class="p-2">${getSupertrendEntryCell(putLtp, false, true)}</td>
                        <td class="p-2 bg-rose-50/40">${getSupertrendEntryCell(putLtp, false, false)}</td>
                    </tr>
                `;
            }

            if(zthCallHtml === '') zthCallHtml = '<div class="text-slate-400 text-[9px] p-1">No low-premium OTM call strikes found.</div>';
            if(zthPutHtml === '') zthPutHtml = '<div class="text-slate-400 text-[9px] p-1">No low-premium OTM put strikes found.</div>';

            document.getElementById('zth-call-list').innerHTML = zthCallHtml;
            document.getElementById('zth-put-list').innerHTML = zthPutHtml;
        }

        window.onload = () => { refreshIndex(); refreshData(); };
    </script>
</body>
  </html>
  
